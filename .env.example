# GCP & BigQuery Configuration
# Rename or copy this file to '.env' (or run ./install.sh) before running or deploying the agent

# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCP Deployment Region for Vertex AI Agent Engine / Cloud Run (default: us-central1)
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI Gemini Model Endpoint (gemini-3.8-flash requires 'global')
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_LOCATION=global

# BigQuery Dataset Name containing Medicaid application records
BIGQUERY_DATASET=frauddector

# BigQuery Table Name within the dataset
BIGQUERY_TABLE=syntheticdatafraud

# Optional: Enable Vertex AI mode (default: True)
GOOGLE_GENAI_USE_VERTEXAI=True

# Telemetry & Cloud Trace Configuration
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
# Options: NO_CONTENT (default, metadata only), EVENT_ONLY, SPAN_ONLY, SPAN_AND_EVENT
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Optional: Comma-separated Gemini Enterprise App / Engine resource URIs for publishing
# Format: projects/<PROJECT_NUMBER>/locations/global/collections/default_collection/engines/<ENGINE_ID>
GEMINI_ENTERPRISE_APPS=
